        <mxCell id="p1_s1" parent="p1_server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;align=left;spacingLeft=15;" value="&lt;b&gt;Tầng Xác Thực &amp; Phân Quyền Bảo Mật&lt;/b&gt;&#xa;• Xác thực mã JWT Token&#xa;• Kiểm tra ma trận phân quyền vai trò (RBAC)&#xa;• Tự động ghi nhật ký bảo mật (Địa chỉ IP, Thao tác, Thời gian)" vertex="1">
          <mxGeometry height="75" width="560" x="30" y="45" as="geometry" />
