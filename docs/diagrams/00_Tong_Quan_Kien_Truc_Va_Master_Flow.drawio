        <mxCell id="p1_s4" parent="p1_server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;align=left;spacingLeft=15;" value="&lt;b&gt;Động Cơ Điểm Danh &amp; Kiểm Soát Vắng Học&lt;/b&gt;&#xa;• Quản lý buổi/tiết điểm danh&#xa;• Tự động quét giới hạn vắng: Cảnh báo tại 40 buổi, Ngưỡng 45 buổi" vertex="1">
