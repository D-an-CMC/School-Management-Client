        <mxCell id="p1_s2" parent="p1_server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;align=left;spacingLeft=15;" value="&lt;b&gt;Các Dịch Vụ Nghiệp Vụ Cốt Lõi&lt;/b&gt;&#xa;• Quản lý Người dùng, Học sinh, Giáo viên&#xa;• Quản lý Lớp học, Phòng học, Năm học, Học kỳ" vertex="1">
          <mxGeometry height="65" width="560" x="30" y="135" as="geometry" />
