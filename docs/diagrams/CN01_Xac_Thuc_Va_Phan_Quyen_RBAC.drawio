  <!-- TIÊU ĐỀ CHÍNH -->
  <mxCell id="m1_auth_header" value="&lt;b&gt;CHỨC NĂNG 1: XÁC THỰC NGƯỜI DÙNG, PHÂN QUYỀN VAI TRÒ (RBAC) & BẢO MẬT HỆ THỐNG&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
