    <mxCell id="m1_ac4" style="strokeWidth=2;" edge="1" parent="m1_auth_act_box" source="m1_a_db" target="m1_a_pw_check"/>
    <mxCell id="m1_ac5" value="Đúng" style="strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="m1_auth_act_box" source="m1_a_pw_check" target="m1_a_jwt"/>
    <mxCell id="m1_ac6" style="strokeWidth=2;" edge="1" parent="m1_auth_act_box" source="m1_a_jwt" target="m1_a_end"/>
  

