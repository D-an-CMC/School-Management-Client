    <mxCell id="m1_sc1" value="1. Gửi yêu cầu đăng nhập { tên tài khoản, mật khẩu }" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#3B82F6;strokeWidth=2;" edge="1" parent="m1_auth_seq_box"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="140" as="sourcePoint"/><mxPoint x="525" y="140" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="m1_sc2" value="2. Truy vấn thông tin người dùng từ bảng users" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="m1_auth_seq_box"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="200" as="sourcePoint"/><mxPoint x="760" y="200" as="targetPoint"/></mxGeometry></mxCell>
