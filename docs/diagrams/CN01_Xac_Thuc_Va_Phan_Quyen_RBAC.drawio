  </mxCell>
  
    <mxCell id="m1_u_admin" value="Quản Trị Viên / BGH" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="50" y="80" width="50" height="90" as="geometry" /></mxCell>
    <mxCell id="m1_u_gv" value="Giáo Viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="50" y="270" width="50" height="90" as="geometry" /></mxCell>
