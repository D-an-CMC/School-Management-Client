  <mxCell id="m1_auth_seq_box" value="&lt;b&gt;3. SƠ ĐỒ TUẦN TỰ (Tương Tác Giao Diện &lt;--&gt; Máy Chủ &lt;--&gt; Cơ Sở Dữ Liệu)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;rounded=1;fontSize=15;" vertex="1" parent="1">
