    <mxCell id="m1_uc2" value="Đăng xuất khỏi tài khoản" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="250" y="160" width="240" height="60" as="geometry" /></mxCell>
