  <mxCell id="p3_title" value="&lt;b&gt;CHỨC NĂNG 4: XẾP THỜI KHÓA BIỂU TỰ ĐỘNG &amp; ĐIỀU CHỈNH THỦ CÔNG&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#0F172A;" vertex="1" parent="1">
    <mxGeometry x="500" y="20" width="1600" height="40" as="geometry" />
  </mxCell>
  <mxCell id="p3_box_algo" value="&lt;b&gt;QUY TRÌNH THUẬT TOÁN TỐI ƯU HÓA XẾP THỜI KHÓA BIỂU TỰ ĐỘNG&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;rounded=1;fontSize=15;" vertex="1" parent="1">
    <mxGeometry x="50" y="80" width="2530" height="700" as="geometry" />
  </mxCell>
  <mxCell id="p3_t1" value="&lt;b&gt;1. Tải Ràng Buộc Dữ Liệu Đầu Vào&lt;/b&gt;&#xa;• Danh sách Lớp theo Khối 6, 7, 8, 9&#xa;• Giáo viên bộ môn &amp; Định mức số tiết/tuần&#xa;• Phòng chức năng (Tin học, Thí nghiệm, Âm nhạc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;align=left;spacingLeft=15;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="50" y="60" width="340" height="110" as="geometry" />
  </mxCell>
  <mxCell id="p3_t2" value="&lt;b&gt;2. Phân Rã Môn Khoa Học Tự Nhiên&lt;/b&gt;&#xa;Tách môn KHTN thành:&#xa;• KHTN - Phân môn Vật Lý&#xa;• KHTN - Phân môn Hóa Học&#xa;• KHTN - Phân môn Sinh Học&#xa;Phân bổ đúng giáo viên chuyên ngành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;align=left;spacingLeft=15;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="450" y="60" width="330" height="110" as="geometry" />
  </mxCell>
  <mxCell id="p3_t3" value="&lt;b&gt;3. Khởi Tạo Ma Trận Tiết Học Tuần&lt;/b&gt;&#xa;6 ngày (Thứ 2 đến Thứ 7)&#xa;x 10 tiết (5 tiết Sáng + 5 tiết Chiều)&#xa;x Số lượng các Lớp học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;align=left;spacingLeft=15;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="840" y="60" width="300" height="110" as="geometry" />
  </mxCell>
  <mxCell id="p3_t4" value="&lt;b&gt;4. Kiểm Tra Ràng Buộc Cứng&lt;/b&gt;&#xa;1. Giáo viên có bị trùng 2 lớp cùng tiết?&#xa;2. Phòng chức năng có bị trùng 2 lớp?&#xa;3. Có vượt quá 3 tiết liên tiếp/môn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="1200" y="35" width="290" height="160" as="geometry" />
  </mxCell>
  <mxCell id="p3_t_backtrack" value="&lt;b&gt;Thuật Toán Quay Lui (Backtracking)&lt;/b&gt;&#xa;Thử lại khung giờ khác hoặc hoán đổi tiết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#FB923C;fontColor=#7C2D12;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="1205" y="260" width="280" height="70" as="geometry" />
  </mxCell>
  <mxCell id="p3_t5" value="&lt;b&gt;5. Sinh Bản Thảo Thời Khóa Biểu&lt;/b&gt;&#xa;Hiển thị lưới TKB trên giao diện quản trị&#xa;Cho phép kéo thả điều chỉnh thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;align=left;spacingLeft=15;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="1570" y="60" width="360" height="110" as="geometry" />
  </mxCell>
  <mxCell id="p3_t6" value="&lt;b&gt;6. Phát Hành Thời Khóa Biểu Chính Thức&lt;/b&gt;&#xa;Lưu dữ liệu vào bảng timetables&#xa;Gửi thông báo tới toàn bộ Giáo viên &amp; Học sinh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;align=left;spacingLeft=15;" vertex="1" parent="p3_box_algo">
    <mxGeometry x="2000" y="60" width="330" height="110" as="geometry" />
  </mxCell>
