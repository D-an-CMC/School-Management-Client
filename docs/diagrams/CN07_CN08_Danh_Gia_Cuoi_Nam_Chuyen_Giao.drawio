  <diagram id="diag_cn7_8" name="CN7&8 - Đánh Giá Cuối Năm & Chuyển Giao Năm Học">
    <mxGraphModel dx="3600" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2400" math="0" shadow="0">
      <root>
