    <mxCell id="m1_c5" style="strokeColor=#A855F7;strokeWidth=2;" edge="1" parent="m1_auth_uc_box" source="m1_u_admin" target="m1_uc4"/>
  

  <!-- 2. SƠ ĐỒ HOẠT ĐỘNG (GÓC TRÊN Ở GIỮA) -->
  <mxCell id="m1_auth_act_box" value="&lt;b&gt;2. SƠ ĐỒ HOẠT ĐỘNG (Quy Trình Nghiệp Vụ &amp; Ràng Buộc)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;rounded=1;fontSize=15;" vertex="1" parent="1">
    <mxGeometry x="880" y="80" width="920" height="700" as="geometry" />
  </mxCell>
  
    <mxCell id="m1_a_start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3B82F6;fontColor=#FFFFFF;" vertex="1" parent="m1_auth_act_box"><mxGeometry x="40" y="60" width="90" height="50" as="geometry" /></mxCell>
    <mxCell id="m1_a_input" value="Nhập Tên tài khoản &amp; Mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="m1_auth_act_box"><mxGeometry x="170" y="55" width="220" height="60" as="geometry" /></mxCell>
    <mxCell id="m1_a_val" value="Đúng định dạng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;" vertex="1" parent="m1_auth_act_box"><mxGeometry x="430" y="45" width="130" height="80" as="geometry" /></mxCell>
    <mxCell id="m1_a_db" value="Truy vấn CSDL &amp; So khớp mã hóa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;" vertex="1" parent="m1_auth_act_box"><mxGeometry x="385" y="170" width="220" height="60" as="geometry" /></mxCell>
