  <!-- TIÊU ĐỀ CHÍNH -->
  <mxCell id="m1_auth_header" value="&lt;b&gt;CHỨC NĂNG 1: XÁC THỰC NGƯỜI DÙNG, PHÂN QUYỀN VAI TRÒ (RBAC) & BẢO MẬT HỆ THỐNG&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
    <mxGeometry x="600" y="20" width="1600" height="45" as="geometry" />
  </mxCell>

  <!-- 1. SƠ ĐỒ USE CASE (GÓC TRÊN BÊN TRÁI) -->
  <mxCell id="m1_auth_uc_box" value="&lt;b&gt;1. SƠ ĐỒ USE CASE (Các Chức Năng &amp; Tác Nhân)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;rounded=1;fontSize=15;" vertex="1" parent="1">
    <mxGeometry x="50" y="80" width="800" height="700" as="geometry" />
  </mxCell>
  
    <mxCell id="m1_u_admin" value="Quản Trị Viên / BGH" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="50" y="80" width="50" height="90" as="geometry" /></mxCell>
    <mxCell id="m1_u_gv" value="Giáo Viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="50" y="270" width="50" height="90" as="geometry" /></mxCell>
    <mxCell id="m1_u_hs" value="Học Sinh / Phụ Huynh" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="50" y="470" width="50" height="90" as="geometry" /></mxCell>
    <mxCell id="m1_uc1" value="Đăng nhập hệ thống (Bcrypt + JWT)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="250" y="70" width="240" height="60" as="geometry" /></mxCell>
    <mxCell id="m1_uc2" value="Đăng xuất khỏi tài khoản" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="250" y="160" width="240" height="60" as="geometry" /></mxCell>
    <mxCell id="m1_uc3" value="Khóa / Mở khóa tài khoản người dùng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="250" y="270" width="240" height="60" as="geometry" /></mxCell>
    <mxCell id="m1_uc4" value="Cấu hình ma trận phân quyền vai trò" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;" vertex="1" parent="m1_auth_uc_box"><mxGeometry x="250" y="380" width="240" height="60" as="geometry" /></mxCell>
    <mxCell id="m1_c1" style="strokeColor=#3B82F6;strokeWidth=2;" edge="1" parent="m1_auth_uc_box" source="m1_u_admin" target="m1_uc1"/>
